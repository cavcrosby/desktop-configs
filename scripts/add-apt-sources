#!/bin/bash
#
# Adds APT data sources/sources.list(5) files and those related. These include
# preferences fragment (apt_preferences(5)) and keyring files.

set -eo pipefail

# constants
PROGNAME="$(basename "$0")"
readonly PROGNAME
readonly ROOT_UID=0
APT_SOURCES_PATHS=(
    "./src/apt/01-docker.sources"
    "./src/apt/01-hashicorp.sources"
    "./src/apt/01-helm.sources"
    "./src/apt/01-vscodium.sources"
    "./src/apt/01-mozilla.sources"
    "./src/apt/01-opentofu.sources"
    "./src/apt/99-debian.sources"
    "./src/apt/00-homelab-prod.sources"
)

APT_PREFERENCES_PATHS=(
    "./src/apt/mozilla.pref"
    "./src/apt/homelab-prod.pref"
)

install_homelab_staging="${1:-false}"

if [ "$(id --user)" != "${ROOT_UID}" ]; then
    printf "%s: %s\n" "${PROGNAME}" "you must run this as root" >&2
    exit 1
fi

rm --force "/etc/apt/sources.list"
if [ "${install_homelab_staging}" = "true" ]; then
    APT_SOURCES_PATHS+=("./src/apt/00-homelab-staging.sources")
    APT_PREFERENCES_PATHS+=("./src/apt/homelab-staging.pref")
fi

install \
    --mode 644 \
    "${APT_SOURCES_PATHS[@]}" \
    "/etc/apt/sources.list.d"

find \
    "${APT_PREFERENCES_PATHS[@]}" \
    -exec sh -c '\
        pref_file="${1#./src/apt/}";
        install --mode 644 "$1" "/etc/apt/preferences.d/${pref_file%.pref}"
    ' "$0" "{}" ";"

install \
    --mode 644 \
    "./src/apt/opentofu.gpg" \
    "./src/apt/opentofu-repo.gpg" \
    "/etc/apt/keyrings"

install --mode 644 "./src/apt/apt.conf" "/etc/apt/apt.conf.d/99homelab"
find \
    "./src/apt" \
    -name "*.sources.local" \
    -exec sh -c '\
        local_file="${1#./src/apt/}";
        install --mode 644 "$1" "/etc/apt/sources.list.d/${local_file%.local}"
    ' "$0" "{}" ";"

find \
    "./src/apt" \
    -name "*.gpg.local" \
    -exec sh -c '\
        local_file="${1#./src/apt/}";
        install --mode 644 "$1" "/etc/apt/keyrings/${local_file%.local}"
    ' "$0" "{}" ";"

apt-get update

exit 0
